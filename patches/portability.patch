 #include <sys/mman.h>
+
+// MADV_HUGEPAGE is Linux-only; it is an advisory hint, so defining it away on
+// other platforms (e.g. macOS) leaves allocation behaviour unchanged.
+#ifndef MADV_HUGEPAGE
+#define MADV_HUGEPAGE 0
+#endif
+
+#ifndef PARLAYANN_ALIGNED_ALLOC
+#define PARLAYANN_ALIGNED_ALLOC
+// POSIX (and macOS) require aligned_alloc's size to be a multiple of the
+// alignment; glibc tolerates other sizes. Round up so the call is portable.
+// Over-allocating to the 2MB boundary matches the huge-page intent anyway.
+static inline void* parlayann_aligned_alloc(size_t alignment, size_t size) {
+  size_t rounded = ((size + alignment - 1) / alignment) * alignment;
+  return aligned_alloc(alignment, rounded);
+}
+#endif
