index 17e8eed..f46833f 100644
--- a/algorithms/bench/parallelDefsANN
+++ b/algorithms/bench/parallelDefsANN
@@ -5,7 +5,16 @@ JEMALLOCLD = $(shell jemalloc-config --libdir)
 JEMALLOC = -L$(JEMALLOCLD) -ljemalloc 
 endif
 
-CCFLAGS = -mcx16 -O3 -std=c++17 -march=native -DNDEBUG -I .
+# x86 needs -mcx16 for 128-bit CAS; arm64 has it natively and clang rejects the flag.
+# Apple clang also rejects -march=native on arm64, where -mcpu=native is the equivalent.
+ARCH = $(shell uname -m)
+ifeq ($(ARCH),arm64)
+ARCHFLAGS = -mcpu=native
+else
+ARCHFLAGS = -mcx16 -march=native
+endif
+
+CCFLAGS = $(ARCHFLAGS) -O3 -std=c++17 -DNDEBUG -I .
 CLFLAGS = -ldl $(JEMALLOC)
 
 OMPFLAGS = -DPARLAY_OPENMP -fopenmp
